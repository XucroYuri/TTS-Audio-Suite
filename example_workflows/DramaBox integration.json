      "widgets_values": [
        "# DramaBox Prompt Template Example\n\nThis Engine node uses the following prompt template:\n\n`A person laughs hard \"hahaha\", then speaks, \"{seg}\"`\n\nThe template is applied to every plain text segment. This means the person will laugh before speaking each segment.\n\nSegments that already contain quotation marks are treated as complete scene prompts and are not wrapped with this template.\n\nThis is only an example. Edit or clear the template if you do not want laughter added to every plain segment."
      ],
      "color": "#432",
      "bgcolor": "#653"
    }
